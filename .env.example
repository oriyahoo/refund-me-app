# Refund-Me settings for docker-compose.yml. Copy to .env and change what you need; everything is
# optional, and the setup wizard in the browser covers the rest.

# The version to run. "latest" follows every release; a number (e.g. 0.1.0) stays put until you
# change it. Releases: CHANGELOG.md.
REFUND_ME_VERSION=latest

# The port on this server (http://<server>:3855). Put an HTTPS proxy in front for real use.
REFUND_ME_PORT=3855

# The address people use, e.g. https://expenses.company.co.il
# APP_URL=

# More names the server answers to, comma-separated (a name not listed gets "unknown host").
# ALLOWED_HOSTS=expenses.office.local

# Behind a proxy: the header it puts the visitor's address in, and the proxy's own addresses.
# Behind Cloudflare: CLIENT_IP_HEADER=cf-connecting-ip,x-forwarded-for
# CLIENT_IP_HEADER=
# TRUSTED_PROXIES=

# Time zone for due days and reminders (default Asia/Jerusalem), and the hour reminders go out.
# APP_TIMEZONE=Asia/Jerusalem
# REMINDER_HOUR=9

# Memory cap for the app container (raise for big companies; check with `docker stats`).
# REFUND_ME_MEMORY_LIMIT=4g

# Only with the bundled database (docker compose --profile postgres up -d): its admin password.
# install.sh --postgres fills it in.
# POSTGRES_ADMIN_PASSWORD=

# Emergency: nobody can manage the app. This person becomes an admin on the next start, once.
# Remove it afterwards.
# RECOVERY_ADMIN_EMAIL=
